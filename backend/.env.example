DATABASE_URL=postgresql+asyncpg://schemalens:schemalens@localhost:5432/schemalens

# Authentication
JWT_SECRET_KEY=replace-with-a-very-long-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_PEPPER=replace-with-a-secure-random-string
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
AUTHENTICATION_ISSUER=schemalens-api
AUTHENTICATION_AUDIENCE=schemalens-client

# Secret Management
# LOCAL_SECRET_MASTER_KEY is required for the local encrypted secret provider.
# It must be a 32-byte base64-encoded key. You can generate one via:
# python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode('utf-8'))"
LOCAL_SECRET_MASTER_KEY=replace-with-base64-encoded-32-byte-key
LOCAL_SECRET_KEY_VERSION=v1
SECRET_VALUE_MAX_BYTES=16384
SECRET_REFERENCE_MAX_LENGTH=512

# AWS Secrets Manager Integration
AWS_REGION=
AWS_SECRETS_MANAGER_ENDPOINT_URL=
AWS_SECRETS_MANAGER_TIMEOUT_SECONDS=5

# Worker and Redis Settings
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_EAGER_PROPAGATES=true
CELERY_TASK_ACKS_LATE=true
CELERY_WORKER_PREFETCH_MULTIPLIER=1

SCHEMA_SCAN_QUEUE_NAME=schema-scans
SCHEMA_SCAN_TASK_SOFT_TIME_LIMIT_SECONDS=600
SCHEMA_SCAN_TASK_HARD_TIME_LIMIT_SECONDS=660
SCHEMA_SCAN_STALE_AFTER_SECONDS=900
SCHEMA_SCAN_HEARTBEAT_INTERVAL_SECONDS=30
SCHEMA_SCAN_MAX_ATTEMPTS=3
SCHEMA_SCAN_MAX_REQUESTED_SCHEMAS=100
SCHEMA_SCAN_DISPATCH_TIMEOUT_SECONDS=5

